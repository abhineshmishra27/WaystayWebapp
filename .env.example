# Database. src/lib/db.ts resolves these in order:
#   WAYSTAY_DATABASE_URL -> DATABASE_URL -> WAYSTAY_DATABASE_URL_UNPOOLED -> DIRECT_URL
# Runtime traffic should use the pooled URL; the unpooled/direct URL is what the Prisma
# CLI uses for migrations (see prisma.config.ts). Keep stale entries OUT of .env.local:
# an unused-but-present URL pointing at a decommissioned database is a trap, because any
# code reading DATABASE_URL directly - or any reordering of that fallback chain - lands
# on it silently.
WAYSTAY_DATABASE_URL="postgresql://user:password@host-pooler.example.neon.tech/db?sslmode=require"
WAYSTAY_DATABASE_URL_UNPOOLED="postgresql://user:password@host.example.neon.tech/db?sslmode=require"

# Connection pool bounds. Defaults suit a serverless Postgres that suspends when idle:
# connections are recycled before the provider can kill them, so a long-running server
# cannot get stuck reusing dead sockets. Override only if you have a reason to.
# DATABASE_POOL_MAX="10"
# DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
# DATABASE_POOL_MAX_LIFETIME_SECONDS="1800"
# DATABASE_CONNECTION_TIMEOUT_MS="10000"

# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_me"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"

# Use a separate secret configured on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET="replace_with_a_long_random_secret"

# Authorizes calls to /api/cron/expire-stale-payments (Vercel sends this automatically
# for scheduled cron invocations when this variable is set; any other caller must send
# `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET="replace_with_a_long_random_secret"
# Minutes a Razorpay-pending booking can sit unpaid before the cron job cancels it and
# releases the room slot. Defaults to 20 if unset.
PAYMENT_EXPIRY_MINUTES="20"

# Days of past RoomSlot rows /api/cron/prune-past-slots keeps before deleting them.
# Slots referenced by a booking are never deleted, whatever this is set to.
# Defaults to 30 if unset.
SLOT_RETENTION_DAYS="30"

# Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID="replace_with_google_oauth_client_id"
AUTH_GOOGLE_SECRET="replace_with_google_oauth_client_secret"

# OTP delivery. Keep OTP_DEMO_MODE false or unset in production.
# Email OTP uses the existing Resend integration and a verified sender domain.
RESEND_API_KEY="re_replace_me"
OTP_EMAIL_FROM="Waystay <noreply@waystay.co.in>"
EMAIL_FROM="Waystay <noreply@waystay.co.in>"

# Firebase Authentication handles mobile OTP. Firebase web configuration is public,
# but keep server-only credentials out of NEXT_PUBLIC variables.
FIREBASE_PROJECT_ID="replace_with_firebase_project_id"
NEXT_PUBLIC_FIREBASE_API_KEY="replace_with_firebase_web_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="replace_with_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="replace_with_firebase_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="replace_with_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace_with_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace_with_firebase_web_app_id"

OTP_DEMO_MODE="true"
