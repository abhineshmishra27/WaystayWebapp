# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_me"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"

# Use a separate secret configured on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET="replace_with_a_long_random_secret"

# Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID="replace_with_google_oauth_client_id"
AUTH_GOOGLE_SECRET="replace_with_google_oauth_client_secret"
