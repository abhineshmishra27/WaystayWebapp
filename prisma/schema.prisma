generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  CUSTOMER
}

enum SlotType {
  H3
  H6
  H9
  H12
  FULLDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum LocationType {
  CITY
  LOCALITY
  LANDMARK
  AIRPORT
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HotelListingRequestStatus {
  PENDING
  REVIEWED
  REJECTED
}

/// A channel manager / PMS that supplies external inventory. Distinct from
/// PartnerApplication, which is WayStay's hotel-owner acquisition funnel.
enum ChannelProvider {
  CLOUDBEDS
}

enum ChannelConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum ChannelSyncKind {
  IMPORT
  AVAILABILITY
  PUSH
  WEBHOOK
}

enum ChannelSyncOutcome {
  SUCCESS
  PARTIAL
  FAILED
}

enum ChannelPushStatus {
  PENDING
  PUSHED
  FAILED
  ABANDONED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  name            String
  phone           String?   @unique
  firebaseUid     String?   @unique
  phoneVerifiedAt DateTime?
  role            Role      @default(CUSTOMER)
  avatarUrl       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hotels                      Hotel[]
  bookings                    Booking[]
  reviews                     Review[]
  uploadedImages              HotelImage[]
  auditLogs                   AuditLog[]
  channelConnections          ChannelConnection[]   @relation("ChannelConnectionOwner")
  reviewedPartnerApplications PartnerApplication[]  @relation("PartnerApplicationReviewer")
  hotelListingRequests        HotelListingRequest[] @relation("HotelListingRequestOwner")
  reviewedHotelRequests       HotelListingRequest[] @relation("HotelListingRequestReviewer")
}

model PartnerApplication {
  id            String                   @id @default(cuid())
  fullName      String
  businessName  String
  email         String                   @unique
  phone         String                   @unique
  passwordHash  String
  gstNumber     String
  city          String
  state         String
  propertyCount Int                      @default(1)
  message       String?
  status        PartnerApplicationStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?                    @relation("PartnerApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewReason  String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, createdAt])
}

model HotelListingRequest {
  id            String                    @id @default(cuid())
  ownerId       String
  owner         User                      @relation("HotelListingRequestOwner", fields: [ownerId], references: [id])
  hotelName     String
  gstNumber     String
  licenseNumber String?
  address       String
  city          String
  state         String
  pincode       String
  contactPhone  String
  roomCount     Int?
  message       String?
  status        HotelListingRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?                     @relation("HotelListingRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewReason  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([ownerId, status, createdAt])
  @@index([status, createdAt])
}

model OtpChallenge {
  id         String   @id @default(cuid())
  identifier String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, purpose, createdAt])
}

model Hotel {
  id              String                                @id @default(cuid())
  ownerId         String
  owner           User                                  @relation(fields: [ownerId], references: [id])
  locationId      String?
  location        Location?                             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name            String
  description     String
  address         String
  city            String
  state           String
  country         String                                @default("India")
  pincode         String
  lat             Float
  lng             Float
  geoPoint        Unsupported("geography(Point,4326)")? @map("geoPoint")
  highway_tag     Boolean                               @default(false)
  checkInTime     String                                @default("12:00")
  checkOutTime    String                                @default("11:00")
  amenities       String[]
  isApproved      Boolean                               @default(false)
  isActive        Boolean                               @default(true)
  ownerEnabled    Boolean                               @default(true)
  createdAt       DateTime                              @default(now())
  updatedAt       DateTime                              @updatedAt
  checkin_policy  String                                @default("Check-in time is 12 PM")
  checkout_policy String                                @default("Check-out time is 11 AM")
  images          HotelImage[]
  rooms           Room[]
  reviews         Review[]
  rating_avg      Float
  total_review    Int
  /// Nullable because channel-imported properties are not Indian-registered and have
  /// no GST/licence number. Writing placeholder values into compliance fields would be
  /// worse than an explicit null. Manual creation still requires them (see Zod schema
  /// in src/app/api/hotels/route.ts).
  license_number  String?
  gst_number      String?
  restaurant      Restaurant?
  auditLogs       AuditLog[]

  /// Set when this hotel was imported from a channel manager rather than onboarded
  /// directly. Channel-managed hotels are excluded from owner-facing edit flows that
  /// sync would overwrite, and may legitimately lack Indian compliance fields.
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  externalPropertyId  String?

  @@unique([channelConnectionId, externalPropertyId])
  @@index([locationId])
}

model Location {
  id               String          @id @default(cuid())
  name             String
  normalizedName   String
  type             LocationType
  state            String?
  parentLocationId String?
  parentLocation   Location?       @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations   Location[]      @relation("LocationHierarchy")
  latitude         Float
  longitude        Float
  radiusKm         Float?
  boundary         Json?
  aliases          LocationAlias[]
  hotels           Hotel[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([normalizedName])
  @@index([parentLocationId, type])
}

model LocationAlias {
  id              String   @id @default(cuid())
  alias           String
  normalizedAlias String
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([normalizedAlias, locationId])
  @@index([normalizedAlias])
}

model HotelImage {
  id           String   @id @default(cuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?
  caption      String?
  sortOrder    Int      @default(0)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Room {
  id                  String     @id @default(cuid())
  hotelId             String
  hotel               Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String
  type                RoomType   @default(STANDARD)
  description         String
  available           Boolean    @default(true)
  pricePerHour        Float
  price_3h            Float
  price_6h            Float
  price_9h            Float
  price_12h           Float
  priceFullDay        Float
  threeHourEnabled    Boolean    @default(true)
  sixHourEnabled      Boolean    @default(true)
  twelveHourEnabled   Boolean    @default(true)
  nightStayEnabled    Boolean    @default(true)
  inventoryCount      Int        @default(1)
  maxOccupancy        Int        @default(3)
  amenities           String[]
  images              String[]
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  /// Nullable: these are WayStay-specific housekeeping/AI fields that a channel
  /// manager has no equivalent for on imported rooms.
  base_clean_video_id String?
  last_clean_video_id String?
  floor_number        Int?
  area_sqft           Float?
  ai_clean_score      Float?
  ai_last_checked_at  DateTime?
  ai_clean_status     String     @default("clean")
  slots               RoomSlot[]
  channelHolds        ChannelInventoryHold[]
  channelMapping      ChannelRoomMapping?
}

model RoomSlot {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      String
  slotType  SlotType
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  bookings Booking[]

  @@unique([roomId, date, slotType, startTime])
}

/// One connected external property. OAuth credentials are stored encrypted
/// (AES-256-GCM via src/lib/crypto.ts) - never write raw tokens to these columns.
model ChannelConnection {
  id                 String                  @id @default(cuid())
  provider           ChannelProvider         @default(CLOUDBEDS)
  externalPropertyId String
  propertyName       String?
  ownerId            String
  owner              User                    @relation("ChannelConnectionOwner", fields: [ownerId], references: [id])
  status             ChannelConnectionStatus @default(PENDING)
  currency           String                  @default("INR")
  propertyTimezone   String                  @default("Asia/Kolkata")

  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  scopes          String[]

  /// Per-connection kill switch. Sync entry points must check this before any work.
  syncEnabled         Boolean   @default(true)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  consecutiveFailures Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels       Hotel[]
  roomMappings ChannelRoomMapping[]
  bookingPushes ChannelBookingMapping[]
  syncLogs     ChannelSyncLog[]

  @@unique([provider, externalPropertyId])
  @@index([status, syncEnabled])
}

/// Maps an external room type to the WayStay Room it was imported into.
model ChannelRoomMapping {
  id                 String            @id @default(cuid())
  connectionId       String
  connection         ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalRoomTypeId String
  externalRatePlanId String?
  roomId             String
  room               Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([connectionId, externalRoomTypeId])
  @@unique([roomId])
}

/// Tracks pushing a WayStay booking out to the channel. bookingId doubles as the
/// provider-side idempotency key (Cloudbeds `thirdPartyIdentifier`), so retries
/// cannot create duplicate reservations.
model ChannelBookingMapping {
  id                    String            @id @default(cuid())
  bookingId             String            @unique
  booking               Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  connectionId          String
  connection            ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalReservationId String?
  pushStatus            ChannelPushStatus @default(PENDING)
  pushAttempts          Int               @default(0)
  lastPushedAt          DateTime?
  lastPushError         String?
  nextRetryAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([pushStatus, nextRetryAt])
}

/// Audit trail and dead-letter queue for every sync operation. This table is the
/// integration's observability surface - it is what /admin/channels renders.
model ChannelSyncLog {
  id           String             @id @default(cuid())
  connectionId String?
  connection   ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  kind         ChannelSyncKind
  outcome      ChannelSyncOutcome
  /// Stable per-event key used to make webhook delivery idempotent.
  eventKey     String?            @unique
  message      String?
  payload      Json?
  createdAt    DateTime           @default(now())

  @@index([connectionId, createdAt])
  @@index([kind, outcome, createdAt])
}

/// Inventory a channel partner (PMS/channel manager) has sold outside WayStay.
/// Held units reduce a room's effective inventory for that date - RoomSlot.isBooked
/// is not consulted by the capacity check, so blocking must happen here.
model ChannelInventoryHold {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      String
  unitsHeld Int      @default(0)
  source    String   @default("CLOUDBEDS")
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, date])
  @@index([date])
}

model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id])
  roomSlotId         String
  roomSlot           RoomSlot      @relation(fields: [roomSlotId], references: [id])
  checkIn            DateTime
  checkOut           DateTime
  totalHours         Float
  totalAmount        Decimal       @db.Decimal(12, 2)
  status             BookingStatus @default(PENDING)
  guestName          String
  guestEmail         String
  guestPhone         String
  guestCount         Int           @default(1)
  roomCount          Int           @default(1)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payment       Payment?
  extensions    BookingExtension[]
  review        Review?
  channelPush   ChannelBookingMapping?

  @@index([roomSlotId, status])
}

model BookingExtension {
  id               String   @id @default(cuid())
  bookingId        String
  booking          Booking  @relation(fields: [bookingId], references: [id])
  addedHours       Float
  additionalAmount Decimal  @db.Decimal(12, 2)
  newCheckout      DateTime
  createdAt        DateTime @default(now())
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerPaymentId String?         @unique
  providerOrderId   String?         @unique
  providerRefundId  String?         @unique
  refundedAt        DateTime?
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  events PaymentEvent[]
}

enum PaymentActorType {
  CUSTOMER
  ADMIN
  WEBHOOK
  SYSTEM
}

model PaymentEvent {
  id              String            @id @default(cuid())
  paymentId       String
  payment         Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus      PaymentStatus?
  toStatus        PaymentStatus
  actorType       PaymentActorType
  actorId         String?
  providerEventId String?
  metadata        Json?
  createdAt       DateTime          @default(now())

  @@index([paymentId, createdAt])
}

model WebhookEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider @default(RAZORPAY)
  providerEventId String?        @unique
  eventType      String
  payloadHash    String          @unique
  payload        Json
  outcome        String
  errorMessage   String?
  receivedAt     DateTime        @default(now())

  @@index([eventType, receivedAt])
}

model RateLimitBucket {
  keyHash   String   @id @db.VarChar(64)
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Review {
  id               String       @id @default(cuid())
  bookingId        String       @unique
  booking          Booking      @relation(fields: [bookingId], references: [id])
  customerId       String
  customer         User         @relation(fields: [customerId], references: [id])
  hotelId          String
  hotel            Hotel        @relation(fields: [hotelId], references: [id])
  rating           Int
  title            String
  body             String
  ownerReply       String?
  status           ReviewStatus @default(PUBLISHED)
  moderationReason String?
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  media ReviewMedia[]

  @@index([status, createdAt])
}

model ReviewMedia {
  id       String    @id @default(cuid())
  reviewId String
  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
  type     MediaType @default(IMAGE)
}

model Restaurant {
  id          String   @id @default(cuid())
  hotelId     String   @unique
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItems MenuItem[]
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     String
  name         String
  description  String?
  price        Float
  isVeg        Boolean    @default(false)
  isAvailable  Boolean    @default(true)
  imageUrl     String?
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  hotelId    String?
  hotel      Hotel?   @relation(fields: [hotelId], references: [id])
  metadata   Json?
  createdAt  DateTime @default(now())
}
